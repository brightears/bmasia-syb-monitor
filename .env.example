# Database
DATABASE_URL="postgresql://user:pass@host:5432/syb_monitor"

# Session (32+ chars)
SESSION_SECRET="generate-with-openssl-rand-base64-32"

# Soundtrack API (operator-scope, shared with Nina)
SOUNDTRACK_API_TOKEN=""

# Agent / cron worker bearer token (any random 32+ char string)
AGENT_API_TOKEN=""

# Alert routing — Google Chat webhook (BMAsia Music Ops space)
CHAT_WEBHOOK_URL=""

# Alert routing — Telegram (optional, fallback)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Allowed email allowlist (comma-separated bmasiamusic.com addresses for sign-in)
ALLOWED_EMAILS="norbert@bmasiamusic.com,nikki.h@bmasiamusic.com,keith@bmasiamusic.com,scott@bmasiamusic.com,production@bmasiamusic.com"

# Admin bootstrap (for first sign-in; one-time bcrypt-style password)
ADMIN_EMAIL="norbert@bmasiamusic.com"
ADMIN_PASSWORD=""

# Public app URL (for callback URLs, etc.)
NEXT_PUBLIC_APP_URL="https://bmasia-syb-monitor.onrender.com"

# Polling config
POLL_PAGE_SIZE="50"
POLL_LOOP_INTERVAL_SECONDS="600"
